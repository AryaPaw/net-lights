<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NetLights.Core\NetLights.Core.csproj" />
    <ProjectReference Include="..\..\src\NetLights.Networking\NetLights.Networking.csproj" />
    <ProjectReference Include="..\..\src\NetLights.App\NetLights.App.csproj" />
    <ProjectReference Include="..\..\src\NetLights.UpdateAgent\NetLights.UpdateAgent.csproj" />
    <ProjectReference Include="..\NetLights.TestSupport\NetLights.TestSupport.csproj" />
    <ProjectReference Include="..\NetLights.TestApp\NetLights.TestApp.csproj" />
    <ProjectReference Include="..\NetLights.TestInstaller\NetLights.TestInstaller.csproj" />
  </ItemGroup>
</Project>
