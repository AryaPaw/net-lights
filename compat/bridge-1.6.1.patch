+using NetLights.Updates;
+using Xunit;
+
+namespace NetLights.UnitTests;
+
+public sealed class BridgeSnapshotTests : IDisposable
+{
+    private readonly string _root = Path.Combine(Path.GetTempPath(), "nl-bridge-snapshot-" + Guid.NewGuid().ToString("N"));
+    private string App => Path.Combine(_root, "app");
+    private string Updates => Path.Combine(_root, "updates");
+    private string Exe => Path.Combine(App, "NetLights.exe");
+    public BridgeSnapshotTests()
+    {
+        Directory.CreateDirectory(App);
+        File.WriteAllText(Exe, "original-app");
+        File.WriteAllText(Path.Combine(App, "unins000.exe"), "original-uninstaller");
+    }
+
+    [Fact]
+    public void RecoveryControlFileCannotCollideWithOriginalInstallationPayload()
+    {
+        string original = Path.Combine(App, "installation-metadata.json");
+        string nested = Path.Combine(App, "payload", "installation-metadata.json");
+        Directory.CreateDirectory(Path.GetDirectoryName(nested)!);
+        File.WriteAllText(original, "original-control-name-bytes");
+        File.WriteAllText(nested, "original-payload-name-bytes");
+        using var backup = InstallationSnapshot.Create(Exe, Updates, _ => new Metadata());
+        File.WriteAllText(original, "changed");
+        File.WriteAllText(nested, "changed-nested");
+        File.WriteAllText(Exe, "new-app");
+        Assert.True(backup.Restore());
+        Assert.True(backup.FilesRestored);
+        Assert.Equal("original-control-name-bytes", File.ReadAllText(original));
+        Assert.Equal("original-payload-name-bytes", File.ReadAllText(nested));
+        Assert.Equal("original-app", File.ReadAllText(Exe));
+    }
+
+    [Fact]
+    public void RestoreReplacesInstallerAddedDirectoryWithOriginalFileAndRecreatesEmptyDirectories()
+    {
+        string original = Path.Combine(App, "original.file");
+        string empty = Path.Combine(App, "empty", "nested");
+        File.WriteAllText(original, "old-file");
+        Directory.CreateDirectory(empty);
+        using var backup = InstallationSnapshot.Create(Exe, Updates, _ => new Metadata());
+        File.Delete(original);
+        Directory.CreateDirectory(original);
+        File.WriteAllText(Path.Combine(original, "added.bin"), "installer-added");
+        Directory.Delete(Path.Combine(App, "empty"), recursive: true);
+        Assert.True(backup.Restore());
+        Assert.Equal("old-file", File.ReadAllText(original));
+        Assert.True(Directory.Exists(empty));
+        Assert.Empty(Directory.EnumerateFileSystemEntries(empty));
+    }
+
+    [Fact]
+    public void RestoreRecreatesTheExactDeletedInstallationRootFromItsCapturedPayload()
+    {
+        string empty = Path.Combine(App, "empty", "nested");
+        Directory.CreateDirectory(empty);
+        using var backup = InstallationSnapshot.Create(Exe, Updates, _ => new Metadata());
+        Directory.Delete(App, recursive: true);
+        Assert.True(backup.Restore());
+        Assert.True(backup.FilesRestored);
+        Assert.Equal("original-app", File.ReadAllText(Exe));
+        Assert.Equal("original-uninstaller", File.ReadAllText(Path.Combine(App, "unins000.exe")));
+        Assert.True(Directory.Exists(empty));
+    }
+
+    private sealed class Metadata : IInstallationMetadataSnapshot
+    {
+        public bool Restore() => true;
+        public void WriteRecoveryCopy(string directory)
+        {
+            using var output = new FileStream(Path.Combine(directory, "installation-metadata.json"), FileMode.CreateNew);
+            output.Write("control"u8);
+        }
+    }
+    public void Dispose() => Directory.Delete(_root, recursive: true);
+}
