+++ b/src/NetLights.Updates/UpdateRetryStore.cs
@@ -0,0 +1,75 @@
+using System.Text.Json;
+
+namespace NetLights.Updates;
+
+public sealed record FailedUpdateCandidate(string Version, string Sha256, int Attempts, DateTimeOffset RetryAfterUtc);
+
+/// <summary>Persists a failed candidate before recovery starts another application process.</summary>
+public sealed class UpdateRetryStore
+{
+    private readonly string _path;
+    private readonly TimeProvider _time;
+    private static readonly JsonSerializerOptions Options = new() { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
+
+    public UpdateRetryStore(string root, TimeProvider? time = null)
+    {
+        _path = Path.Combine(root, "failed-candidate.json");
+        _time = time ?? TimeProvider.System;
+    }
+
+    public string Root => Path.GetDirectoryName(_path)!;
+
+    public bool AllowsAutomaticAttempt(string version, string sha256)
+    {
+        try
+        {
+            FailedUpdateCandidate? failed = Read();
+            return failed is null || !Matches(failed, version, sha256) || _time.GetUtcNow() >= failed.RetryAfterUtc;
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or JsonException or InvalidDataException)
+        {
+            // An unreadable guard must not turn recovery into another install loop.
+            return false;
+        }
+    }
+
+    public void RecordFailure(string version, string sha256)
+    {
+        if (!Version.TryParse(UpdatePolicy.Normalize(version), out Version? normalized)
+            || sha256.Length != 64 || !sha256.All(Uri.IsHexDigit))
+            throw new InvalidDataException("Invalid failed update candidate.");
+        int attempts = 1;
+        try
+        {
+            FailedUpdateCandidate? previous = Read();
+            if (previous is not null && Matches(previous, version, sha256))
+                attempts = Math.Min(previous.Attempts + 1, 8);
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or JsonException or InvalidDataException) { }
+        TimeSpan cooldown = TimeSpan.FromHours(Math.Min(12 * Math.Pow(2, attempts - 1), 7 * 24));
+        var failed = new FailedUpdateCandidate(normalized.ToString(), sha256.ToLowerInvariant(), attempts, _time.GetUtcNow() + cooldown);
+        PendingUpdateStore.WriteAtomic(_path, JsonSerializer.Serialize(failed, Options));
+    }
+
+    private FailedUpdateCandidate? Read()
+    {
+        try
+        {
+            using FileStream input = new(_path, FileMode.Open, FileAccess.Read, FileShare.Read | FileShare.Delete);
+            if (input.Length > 4096) throw new InvalidDataException("Update retry state is too large.");
+            FailedUpdateCandidate failed = JsonSerializer.Deserialize<FailedUpdateCandidate>(input, Options)
+                ?? throw new InvalidDataException("Missing update retry state.");
+            if (!Version.TryParse(failed.Version, out _) || failed.Sha256 is not { Length: 64 }
+                || !failed.Sha256.All(Uri.IsHexDigit) || failed.Attempts is < 1 or > 8
+                || failed.RetryAfterUtc == default)
+                throw new InvalidDataException("Invalid update retry state.");
+            return failed;
+        }
+        catch (FileNotFoundException) { return null; }
+        catch (DirectoryNotFoundException) { return null; }
+    }
+
+    private static bool Matches(FailedUpdateCandidate failed, string version, string sha256)
+        => string.Equals(failed.Version, UpdatePolicy.Normalize(version), StringComparison.OrdinalIgnoreCase)
+            && IntegrityVerifier.Matches(failed.Sha256, sha256);
+}
