+        File.WriteAllText(fixture.Store.ResultPath, "preserved result");
+        var environment = new Dictionary<string, string>
+        {
+            [duringHealthCheck ? "NL_TEST_APP_START_GATE" : "NL_TEST_INSTALL_GATE"] = name,
+            ["NL_TEST_INSTALL_INVOCATIONS"] = invocations
+        };
+        using Process first = fixture.StartAgentProcess(environment);
+        try
+        {
+            Assert.True(entered.WaitOne(TimeSpan.FromSeconds(15)), "First agent did not reach its bounded gate.");
+            Assert.False(first.HasExited);
+            Dictionary<string, byte[]> original = Directory.GetFiles(fixture.Root)
+                .ToDictionary(path => Path.GetFileName(path)!, File.ReadAllBytes, StringComparer.OrdinalIgnoreCase);
+            // Different spelling must still identify the same Windows installation.
+            string alias = Path.Combine(fixture.InstallDirectory, ".", "NETLIGHTS.EXE");
