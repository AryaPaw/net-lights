+                throw new InvalidDataException("Installed shortcut belongs to another application.");
+            if (new FileInfo(shortcutPath).Length > 256 * 1024)
+                throw new InvalidDataException("Installed shortcut exceeds the backup limit.");
+            shortcut = File.ReadAllBytes(shortcutPath);
+            if (shortcut.Length > 256 * 1024) throw new InvalidDataException("Installed shortcut exceeds the backup limit.");
