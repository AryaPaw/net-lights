+    [Fact]
+    public void InstallerTimeoutStopsItsChildWriterBeforeRestoringFiles()
+    {
+        using var fixture = new InstallerFixture("hang-child", "1.5.0", installerWait: TimeSpan.FromSeconds(2));
+        Assert.Equal(7, fixture.Run());
+        Assert.True(fixture.TryGetRunningApp(out _));
+        string childPid = fixture.InstallDirectory + ".child.pid";
+        Assert.True(File.Exists(childPid), "Installer did not create the child writer.");
+        int pid = int.Parse(File.ReadAllText(childPid), System.Globalization.CultureInfo.InvariantCulture);
+        try
+        {
+            using Process writer = Process.GetProcessById(pid);
+            Assert.True(writer.HasExited, "Installer child writer survived rollback.");
+        }
+        catch (ArgumentException) { }
+        Assert.False(File.Exists(Path.Combine(fixture.InstallDirectory, "child-writer.marker")));
+        Assert.Equal("old-app-payload", File.ReadAllText(Path.Combine(fixture.InstallDirectory, "rollback-probe.marker")));
+    }
