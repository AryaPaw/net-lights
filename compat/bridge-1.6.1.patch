+using Microsoft.Win32;
+using NetLights.Updates;
+using System.Runtime.Versioning;
+using Xunit;
+
+namespace NetLights.UnitTests;
+
+[SupportedOSPlatform("windows")]
+public sealed class OwnedInstallationMetadataTests : IDisposable
+{
+    private readonly string _root = Path.Combine(Path.GetTempPath(), "nl-metadata-" + Guid.NewGuid().ToString("N"));
+    private readonly string _keyPath = @"Software\NetLights.Tests\" + Guid.NewGuid().ToString("N");
+    private string Executable => Path.Combine(_root, "app", "NetLights.exe");
+    private string Programs => Path.Combine(_root, "programs");
+    private string Shortcut => Path.Combine(Programs, "Custom Group", "Net Lights.lnk");
+
+    public OwnedInstallationMetadataTests()
+    {
+        Directory.CreateDirectory(Path.GetDirectoryName(Executable)!);
+        Directory.CreateDirectory(Programs);
+        File.WriteAllText(Executable, "old-app");
+        File.WriteAllText(Path.Combine(Path.GetDirectoryName(Executable)!, "unins000.exe"), "old-uninstaller");
+    }
+
+    [Fact]
+    public void Restore_RestoresTypedValuesAndCustomGroupShortcut()
+    {
+        Register();
+        Directory.CreateDirectory(Path.GetDirectoryName(Shortcut)!);
+        File.WriteAllText(Shortcut, "old-shortcut");
+        using (RegistryKey key = Registry.CurrentUser.OpenSubKey(_keyPath, writable: true)!)
+        {
+            key.SetValue("DisplayVersion", "1.6.0", RegistryValueKind.String);
+            key.SetValue("MajorVersion", 1, RegistryValueKind.DWord);
+            key.SetValue("CustomBinary", new byte[] { 1, 2 }, RegistryValueKind.Binary);
+        }
+        IInstallationMetadataSnapshot metadata = Capture();
+        using (RegistryKey key = Registry.CurrentUser.OpenSubKey(_keyPath, writable: true)!)
+        {
+            key.SetValue("DisplayVersion", "9.0.0");
+            key.SetValue("MajorVersion", 9);
+            key.SetValue("NewValue", "remove");
+        }
+        File.WriteAllText(Shortcut, "new-shortcut");
+        Assert.True(metadata.Restore());
+        using RegistryKey restored = Registry.CurrentUser.OpenSubKey(_keyPath)!;
+        Assert.Equal("1.6.0", restored.GetValue("DisplayVersion"));
+        Assert.Equal(RegistryValueKind.DWord, restored.GetValueKind("MajorVersion"));
+        Assert.Equal(1, restored.GetValue("MajorVersion"));
+        Assert.Equal(new byte[] { 1, 2 }, Assert.IsType<byte[]>(restored.GetValue("CustomBinary")));
+        Assert.Null(restored.GetValue("NewValue"));
+        Assert.Equal("old-shortcut", File.ReadAllText(Shortcut));
+    }
+
+    [Fact]
+    public void Restore_DoesNotTouchReassignedRegistryOrShortcut()
+    {
+        Register();
+        IInstallationMetadataSnapshot metadata = Capture();
+        using (RegistryKey key = Registry.CurrentUser.OpenSubKey(_keyPath, writable: true)!)
+            key.SetValue("InstallLocation", Path.Combine(_root, "foreign"));
+        Assert.False(metadata.Restore());
+        using RegistryKey current = Registry.CurrentUser.OpenSubKey(_keyPath)!;
+        Assert.Equal(Path.Combine(_root, "foreign"), current.GetValue("InstallLocation"));
+    }
+
+    [Fact]
+    public void Restore_DoesNotAcquireKeyAbsentAtCapture()
+    {
+        IInstallationMetadataSnapshot metadata = Capture();
+        Register();
+        using (RegistryKey key = Registry.CurrentUser.OpenSubKey(_keyPath, writable: true)!) key.SetValue("Keep", "foreign");
+        Assert.True(metadata.Restore());
+        using RegistryKey current = Registry.CurrentUser.OpenSubKey(_keyPath)!;
+        Assert.Equal("foreign", current.GetValue("Keep"));
+    }
+
+    [Fact]
+    public void Restore_RechecksWritableKeyAfterShortcutCallbackReassignsOwnership()
+    {
+        Register();
+        Directory.CreateDirectory(Path.GetDirectoryName(Shortcut)!);
+        File.WriteAllText(Shortcut, "old-shortcut");
+        bool restoring = false;
+        IInstallationMetadataSnapshot metadata = OwnedInstallationMetadata.CaptureWindows(Executable, _keyPath, Programs, _ =>
+        {
+            if (restoring)
+            {
+                using RegistryKey key = Registry.CurrentUser.OpenSubKey(_keyPath, writable: true)!;
+                key.SetValue("InstallLocation", Path.Combine(_root, "foreign"));
+                key.SetValue("DisplayVersion", "foreign-version");
+                key.SetValue("KeepForeign", "keep");
+            }
+            return Executable;
+        });
+        restoring = true;
+        Assert.False(metadata.Restore());
+        using RegistryKey current = Registry.CurrentUser.OpenSubKey(_keyPath)!;
+        Assert.Equal(Path.Combine(_root, "foreign"), current.GetValue("InstallLocation"));
+        Assert.Equal("foreign-version", current.GetValue("DisplayVersion"));
+        Assert.Equal("keep", current.GetValue("KeepForeign"));
+        Assert.Equal("old-shortcut", File.ReadAllText(Shortcut));
+    }
+
+    [Fact]
+    public void Restore_RecreatesOwnedRegistrationDeletedByInstaller()
+    {
+        Register();
+        IInstallationMetadataSnapshot metadata = Capture();
+        Registry.CurrentUser.DeleteSubKeyTree(_keyPath);
+        Assert.True(metadata.Restore());
+        using RegistryKey current = Registry.CurrentUser.OpenSubKey(_keyPath)!;
+        Assert.Equal(Path.GetDirectoryName(Executable), current.GetValue("InstallLocation"));
+    }
+
+    [Fact]
+    public void Restore_LeavesForeignShortcutAndRegistrationIntact()
+    {
+        Register();
+        string target = Executable;
+        IInstallationMetadataSnapshot metadata = OwnedInstallationMetadata.CaptureWindows(Executable, _keyPath, Programs, _ => target);
+        Directory.CreateDirectory(Path.GetDirectoryName(Shortcut)!);
+        File.WriteAllText(Shortcut, "foreign-shortcut");
+        target = Path.Combine(_root, "foreign.exe");
+        Assert.False(metadata.Restore());
+        Assert.Equal("foreign-shortcut", File.ReadAllText(Shortcut));
+    }
+
+    [Fact]
+    public void Capture_RejectsTraversalAndOversizedRegistryValues()
+    {
+        Register();
+        using (RegistryKey key = Registry.CurrentUser.OpenSubKey(_keyPath, writable: true)!)
+            key.SetValue("Inno Setup: Icon Group", @"..\foreign");
+        Assert.Throws<InvalidDataException>(() => Capture());
+        Register();
+        using (RegistryKey key = Registry.CurrentUser.OpenSubKey(_keyPath, writable: true)!) key.SetValue("Huge", new string('x', 8193));
+        Assert.Throws<InvalidDataException>(() => Capture());
+    }
+
+    [Fact]
+    public void InstallationRestore_RestartsFilesButRetainsRecoveryCopyWhenMetadataFails()
+    {
+        Register();
+        string updates = Path.Combine(_root, "updates");
+        using (InstallationSnapshot snapshot = InstallationSnapshot.Create(Executable, updates, _ => Capture()))
+        {
+            File.WriteAllText(Executable, "new-app");
+            using (RegistryKey key = Registry.CurrentUser.OpenSubKey(_keyPath, writable: true)!)
+                key.SetValue("InstallLocation", Path.Combine(_root, "foreign"));
+            Assert.False(snapshot.Restore());
+            Assert.True(snapshot.FilesRestored);
+            Assert.Equal("old-app", File.ReadAllText(Executable));
+        }
+        string recovery = Assert.Single(Directory.GetDirectories(Path.Combine(updates, "rollback")));
+        Assert.True(File.Exists(Path.Combine(recovery, "installation-metadata.json")));
+        Assert.Equal("old-app", File.ReadAllText(Path.Combine(recovery, "payload", "NetLights.exe")));
+    }
+
+    [Fact]
+    public void CaptureFailure_AbortsBeforeBackupOrInstalledFilesChange()
+    {
+        string updates = Path.Combine(_root, "updates");
+        Assert.Throws<System.Reflection.TargetInvocationException>(() => InstallationSnapshot.Create(Executable, updates,
+            _ => throw new System.Reflection.TargetInvocationException(new System.Runtime.InteropServices.COMException("Fixture failure."))));
+        Assert.Equal("old-app", File.ReadAllText(Executable));
+        Assert.Equal("old-uninstaller", File.ReadAllText(Path.Combine(Path.GetDirectoryName(Executable)!, "unins000.exe")));
+        Assert.False(Directory.Exists(updates));
+    }
+
+    private IInstallationMetadataSnapshot Capture()
+        => OwnedInstallationMetadata.CaptureWindows(Executable, _keyPath, Programs, _ => Executable);
+
+    private void Register()
+    {
+        using RegistryKey key = Registry.CurrentUser.CreateSubKey(_keyPath);
+        key.SetValue("InstallLocation", Path.GetDirectoryName(Executable)!);
+        key.SetValue("UninstallString", "\"" + Path.Combine(Path.GetDirectoryName(Executable)!, "unins000.exe") + "\"");
+        key.SetValue("Inno Setup: Icon Group", "Custom Group");
+    }
+
+    public void Dispose()
+    {
+        Registry.CurrentUser.DeleteSubKeyTree(_keyPath, throwOnMissingSubKey: false);
+        Directory.Delete(_root, recursive: true);
+    }
+}
