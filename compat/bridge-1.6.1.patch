+            || !SamePath(location, Path.GetDirectoryName(executable)!)) return false;
+        if (key.GetValue("UninstallString", null, RegistryValueOptions.DoNotExpandEnvironmentNames) is not string command
+            || command.Length > 8192) return false;
+        // Inno writes the quoted uninstall executable without arguments.
+        string uninstaller = command.Trim().Trim('"');
+        return SamePath(Path.GetDirectoryName(uninstaller) ?? "", location)
+            && Path.GetFileName(uninstaller).StartsWith("unins", StringComparison.OrdinalIgnoreCase)
+            && string.Equals(Path.GetExtension(uninstaller), ".exe", StringComparison.OrdinalIgnoreCase);
+    }
+
+    [SupportedOSPlatform("windows")]
+    private static Dictionary<string, SavedValue> ReadValues(RegistryKey key)
+    {
+        if (key.SubKeyCount != 0 || key.ValueCount > 64) throw new InvalidDataException("Uninstall registration exceeds the backup limit.");
+        var values = new Dictionary<string, SavedValue>(StringComparer.OrdinalIgnoreCase);
+        int size = 0;
+        foreach (string name in key.GetValueNames())
+        {
+            if (name.Length > 256) throw new InvalidDataException("Invalid uninstall value name.");
+            RegistryValueKind kind = key.GetValueKind(name);
+            object? value = key.GetValue(name, null, RegistryValueOptions.DoNotExpandEnvironmentNames);
+            int length = (kind, value) switch
+            {
+                (RegistryValueKind.String or RegistryValueKind.ExpandString, string text) when text.Length <= 8192 => text.Length * 2,
+                (RegistryValueKind.DWord, int _) => 4,
+                (RegistryValueKind.QWord, long _) => 8,
+                (RegistryValueKind.Binary, byte[] bytes) when bytes.Length <= 65536 => bytes.Length,
+                (RegistryValueKind.MultiString, string[] strings) when strings.Length <= 64 && strings.All(s => s.Length <= 8192) => strings.Sum(s => s.Length * 2),
+                _ => throw new InvalidDataException("Unsupported uninstall value.")
+            };
+            size = checked(size + length + name.Length * 2);
+            if (size > 128 * 1024) throw new InvalidDataException("Uninstall registration exceeds the backup limit.");
+            values.Add(name, new SavedValue(kind, value!));
+        }
+        return values;
+    }
