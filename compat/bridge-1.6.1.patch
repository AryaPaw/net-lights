+            // changed ownership since the initial read; a newly created key must be empty.
+            if (created ? key.ValueCount != 0 || key.SubKeyCount != 0 : !IsOwned(key, _executable)) return false;
+            if (key.SubKeyCount != 0 || key.ValueCount > 64) return false;
+            foreach (string name in key.GetValueNames())
+                if (!_values!.ContainsKey(name)) key.DeleteValue(name, throwOnMissingValue: false);
+            foreach ((string name, SavedValue value) in _values!) key.SetValue(name, value.Value, value.Kind);
+        }
