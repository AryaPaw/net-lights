+    [Fact]
+    public void RecoveryProcessIsOwnedBeforeItsManagedPidRegistration()
+    {
+        using var fixture = new InstallerFixture("fail", "1.5.0");
+        string gateName = "Local\\NetLights.TestAppStartup." + Guid.NewGuid().ToString("N");
+        using var release = new EventWaitHandle(false, EventResetMode.ManualReset, gateName);
+        using var entered = new EventWaitHandle(false, EventResetMode.ManualReset, gateName + ".entered");
+        UpdateAgentTestOptions options = fixture.CreateOptions(TimeSpan.FromSeconds(5));
+        options = options with
+        {
+            ChildEnvironment = new Dictionary<string, string>(options.ChildEnvironment)
+            {
+                ["NL_TEST_APP_START_GATE"] = gateName
+            }
+        };
+        try
+        {
+            Assert.Equal(17, fixture.Run(options: options));
+            Assert.True(entered.WaitOne(TimeSpan.FromSeconds(3)), "Child did not enter its registration gate.");
+            Assert.True(fixture.TryGetRunningApp(out _));
+            Assert.False(File.Exists(Path.Combine(fixture.Root, "spawned-app-pids.txt")),
+                "The negative control must still be before managed PID registration.");
+        }
+        finally { release.Set(); }
+        // Dispose must stop this pinned child even though it never reached its PID-file write.
+    }
