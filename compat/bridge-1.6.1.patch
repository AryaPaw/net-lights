+    [Fact]
+    public void RecoveryAppReadsCurrentFailureAndPersistedCooldownAtStartup()
+    {
+        using var fixture = new InstallerFixture("fail", "1.5.0");
+        Assert.Equal(17, fixture.Run());
+        Assert.True(fixture.TryGetRunningApp(out int pid));
+        string observed = fixture.Store.ResultPath + ".observed-" + pid;
+        Assert.True(SpinWait.SpinUntil(() => File.Exists(observed), TimeSpan.FromSeconds(3)),
+            "Recovered process did not observe the update result.");
+        using var result = System.Text.Json.JsonDocument.Parse(File.ReadAllText(observed));
+        Assert.False(result.RootElement.GetProperty("success").GetBoolean());
+        Assert.Contains("ошибкой 17", result.RootElement.GetProperty("message").GetString());
+        Assert.False(new UpdateRetryStore(fixture.Root).AllowsAutomaticAttempt("1.5.0", fixture.InstallerHash));
+    }
