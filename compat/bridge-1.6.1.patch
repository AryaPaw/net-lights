+            File.WriteAllText(Path.Combine(Path.GetDirectoryName(target)!, Path.GetFileName(target) + ".child.pid"),
+                child.Id.ToString(System.Globalization.CultureInfo.InvariantCulture));
+        }
+
+        if (mode.Equals("hang", StringComparison.OrdinalIgnoreCase) || mode.Equals("hang-child", StringComparison.OrdinalIgnoreCase))
