+++ b/tests/NetLights.UnitTests/UpdateRetryStoreTests.cs
@@ -0,0 +1,59 @@
+using Microsoft.Extensions.Time.Testing;
+using NetLights.Updates;
+using Xunit;
+
+namespace NetLights.UnitTests;
+
+public sealed class UpdateRetryStoreTests : IDisposable
+{
+    private readonly string _root = Path.Combine(Path.GetTempPath(), "nl-update-retry-" + Guid.NewGuid().ToString("N"));
+    private readonly FakeTimeProvider _time = new(new DateTimeOffset(2026, 10, 22, 0, 0, 0, TimeSpan.Zero));
+    private static readonly string Hash = new('a', 64);
+
+    [Fact]
+    public void FailedCandidateIsBlockedAcrossStoreInstancesUntilCooldownExpires()
+    {
+        var store = new UpdateRetryStore(_root, _time);
+        Assert.True(store.AllowsAutomaticAttempt("1.7.0", Hash));
+        store.RecordFailure("v1.7.0", Hash);
+        Assert.False(new UpdateRetryStore(_root, _time).AllowsAutomaticAttempt("1.7.0", Hash));
+        Assert.True(store.AllowsAutomaticAttempt("1.7.1", Hash));
+        Assert.True(store.AllowsAutomaticAttempt("1.7.0", new string('b', 64)));
+        _time.Advance(TimeSpan.FromHours(12));
+        Assert.True(store.AllowsAutomaticAttempt("1.7.0", Hash));
+        store.RecordFailure("1.7.0", Hash);
+        _time.Advance(TimeSpan.FromHours(12));
+        Assert.False(store.AllowsAutomaticAttempt("1.7.0", Hash));
+        _time.Advance(TimeSpan.FromHours(12));
+        Assert.True(store.AllowsAutomaticAttempt("1.7.0", Hash));
+    }
+
+    [Theory]
+    [InlineData("null")]
+    [InlineData("{\"version\":\"1.7.0\",\"sha256\":null,\"attempts\":1}")]
+    [InlineData("{")]
+    public void CorruptGuardBlocksAutomaticAttemptsButCanBeReplacedByRecordedFailure(string json)
+    {
+        Directory.CreateDirectory(_root);
+        File.WriteAllText(Path.Combine(_root, "failed-candidate.json"), json);
+        var store = new UpdateRetryStore(_root, _time);
+        Assert.False(store.AllowsAutomaticAttempt("1.7.0", Hash));
+        store.RecordFailure("1.7.0", Hash);
+        Assert.False(store.AllowsAutomaticAttempt("1.7.0", Hash));
+        Assert.True(store.AllowsAutomaticAttempt("1.7.1", Hash));
+        Assert.Empty(Directory.GetFiles(_root, "*.tmp"));
+    }
+
+    [Fact]
+    public void OversizedGuardBlocksAutomaticAttempts()
+    {
+        Directory.CreateDirectory(_root);
+        File.WriteAllText(Path.Combine(_root, "failed-candidate.json"), new string('x', 4097));
+        Assert.False(new UpdateRetryStore(_root, _time).AllowsAutomaticAttempt("1.7.0", Hash));
+    }
+
+    public void Dispose()
+    {
+        if (Directory.Exists(_root)) Directory.Delete(_root, recursive: true);
+    }
+}
