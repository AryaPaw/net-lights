+    [Fact]
+    public void CrashedAgentCannotBeReplacedWhileItsInstallerIsAliveOrAfterMutexDisappears()
+    {
+        using var fixture = new InstallerFixture("success", "1.5.0");
+        string name = "Local\\NetLights.AgentCrash." + Guid.NewGuid().ToString("N");
+        using var release = new EventWaitHandle(false, EventResetMode.ManualReset, name);
+        using var entered = new EventWaitHandle(false, EventResetMode.ManualReset, name + ".entered");
+        string childPid = Path.Combine(fixture.Root, "installer.pid");
+        var environment = new Dictionary<string, string>
+        {
+            ["NL_TEST_INSTALL_GATE"] = name,
+            ["NL_TEST_INSTALL_PID_FILE"] = childPid
+        };
+        using Process first = fixture.StartAgentProcess(environment);
+        Process? installer = null;
+        Mutex? retainedHandle = null;
+        try
+        {
+            Assert.True(entered.WaitOne(TimeSpan.FromSeconds(15)));
+            installer = Process.GetProcessById(int.Parse(File.ReadAllText(childPid), System.Globalization.CultureInfo.InvariantCulture));
+            _ = installer.SafeHandle;
+            Assert.Equal(Path.Combine(fixture.Root, "NetLights-Setup-win-x64-1.5.0.exe"), installer.MainModule!.FileName,
+                ignoreCase: true);
+            string marker = Assert.Single(Directory.GetFiles(fixture.Root, "active-*.json"));
+            string identity = Path.GetFileName(marker)["active-".Length..^".json".Length];
+            retainedHandle = Mutex.OpenExisting(@"Global\NetLights.UpdateInstallation." + identity);
+            first.Kill(entireProcessTree: false);
+            Assert.True(first.WaitForExit(5000));
+            Assert.False(installer.HasExited);
+            Dictionary<string, byte[]> original = Directory.GetFiles(fixture.Root)
+                .ToDictionary(path => Path.GetFileName(path)!, File.ReadAllBytes, StringComparer.OrdinalIgnoreCase);
+            for (int attempt = 0; attempt < 2; attempt++)
+            {
+                string readyName = "Local\\NetLights.UpdateAgentReady." + Guid.NewGuid().ToString("N");
+                using var ready = new EventWaitHandle(false, EventResetMode.ManualReset, readyName);
+                using Process next = fixture.StartAgentProcess(environment, readyName);
+                Assert.True(next.WaitForExit(5000));
+                Assert.Equal(11, next.ExitCode);
+                Assert.False(ready.WaitOne(0));
+                Assert.False(installer.HasExited);
+                Assert.Equal(original.Keys.Order(), Directory.GetFiles(fixture.Root).Select(path => Path.GetFileName(path)!).Order());
+                foreach ((string file, byte[] bytes) in original)
+                    Assert.Equal(bytes, File.ReadAllBytes(Path.Combine(fixture.Root, file)));
+                // The next attempt cannot rely on an abandoned kernel object:
+                // all handles disappear, while the flushed marker remains.
+                retainedHandle?.Dispose();
+                retainedHandle = null;
+            }
+        }
+        finally
+        {
+            retainedHandle?.Dispose();
+            release.Set();
+            if (!first.HasExited)
+            {
+                first.Kill(entireProcessTree: true);
+                first.WaitForExit(5000);
+            }
+            if (installer is not null)
+            {
+                try
+                {
+                    if (!installer.WaitForExit(5000))
+                    {
+                        installer.Kill(entireProcessTree: true);
+                        Assert.True(installer.WaitForExit(5000));
+                    }
+                }
+                finally { installer.Dispose(); }
+            }
+        }
+    }
