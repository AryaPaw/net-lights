+using NetLights.Updates;
+using Xunit;
+
+namespace NetLights.UnitTests;
+
+public sealed class AgentSilentSetupInstallerTests
+{
+    [Fact]
+    public void InterruptedTransactionRequiresManualInstallationRatherThanAnAutomaticRetry()
+    {
+        Assert.Equal("Сохранена отметка незавершённого обновления. Без подтверждения владельца автоматически удалять её небезопасно. Данные не изменены. Повторный запуск установщика не гарантирует восстановление; нужна проверка этой отметки.",
+            AgentSilentSetupInstaller.FailureForExitCode(11));
+        Assert.Null(AgentSilentSetupInstaller.FailureForExitCode(10));
+        Assert.Null(AgentSilentSetupInstaller.FailureForExitCode(1));
+    }
