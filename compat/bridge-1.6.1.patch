+/// <summary>Only the per-user Inno registration and shortcut owned by this installation.</summary>
+internal sealed class OwnedInstallationMetadata : IInstallationMetadataSnapshot
+{
+    internal const string ProductKey = @"Software\Microsoft\Windows\CurrentVersion\Uninstall\{7C2B1A9E-4F31-4A6D-9C2E-1B8E5D2A0F11}_is1";
+    private readonly string _executable;
+    private readonly string _keyPath;
+    private readonly Dictionary<string, SavedValue>? _values;
+    private readonly string? _shortcutPath;
+    private readonly byte[]? _shortcut;
+    private readonly Func<string, string> _readShortcutTarget;
+    private sealed record SavedValue(RegistryValueKind Kind, object Value);
+
+    private OwnedInstallationMetadata(string executable, string keyPath, Dictionary<string, SavedValue>? values,
+        string? shortcutPath, byte[]? shortcut, Func<string, string> readShortcutTarget)
+    {
+        _executable = executable;
+        _keyPath = keyPath;
+        _values = values;
+        _shortcutPath = shortcutPath;
+        _shortcut = shortcut;
+        _readShortcutTarget = readShortcutTarget;
+    }
+
+    internal static bool HasOwnedRegistration(string executable)
+    {
+        if (!OperatingSystem.IsWindows()) return false;
+        using RegistryKey? key = Registry.CurrentUser.OpenSubKey(ProductKey, writable: false);
+        return key is not null && IsOwned(key, Path.GetFullPath(executable));
+    }
+
+    internal static IInstallationMetadataSnapshot Capture(string executable)
+        => OperatingSystem.IsWindows()
+            ? CaptureWindows(executable, ProductKey, Environment.GetFolderPath(Environment.SpecialFolder.Programs))
+            : new OwnedInstallationMetadata(executable, ProductKey, null, null, null, _ => "");
+
+    [SupportedOSPlatform("windows")]
+    internal static IInstallationMetadataSnapshot CaptureWindows(string executable, string keyPath,
+        string programsDirectory, Func<string, string>? readShortcutTarget = null)
+    {
+        executable = Path.GetFullPath(executable);
+        readShortcutTarget ??= ReadShortcutTarget;
+        using RegistryKey? key = Registry.CurrentUser.OpenSubKey(keyPath);
+        // A portable fixture or another installation must not acquire ownership of this key.
+        if (key is null || !IsOwned(key, executable))
+            return new OwnedInstallationMetadata(executable, keyPath, null, null, null, readShortcutTarget);
+        Dictionary<string, SavedValue> values = ReadValues(key);
+        string group = key.GetValue("Inno Setup: Icon Group", "Net Lights", RegistryValueOptions.DoNotExpandEnvironmentNames) as string
+            ?? throw new InvalidDataException("Invalid installed shortcut group.");
+        if (Path.IsPathRooted(group) || group.Split(['\\', '/']).Any(part => part is "" or "." or ".."
+            || part.EndsWith(' ') || part.EndsWith('.') || part.IndexOfAny(Path.GetInvalidFileNameChars()) >= 0))
+            throw new InvalidDataException("Invalid installed shortcut group.");
+        string shortcutPath = Path.GetFullPath(Path.Combine(programsDirectory, group, "Net Lights.lnk"));
+        if (!UpdatePolicy.IsInsideRoot(Path.GetFullPath(programsDirectory), shortcutPath))
+            throw new InvalidDataException("Shortcut is outside the user programs directory.");
